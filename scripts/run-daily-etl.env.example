APP_BASE_URL="https://your-domain.com"
CRON_SECRET="replace-with-production-secret"

# Comma-separated endpoints to execute in order.
# Keep /api/cron/alert-counts enabled for daily metrics.
ETL_ENDPOINTS="/api/cron/student-sync,/api/cron/alert-counts"

# Optional: attendance API override used by student-sync.
# Default is:
# http://uolerp.uol.edu.pk:8000/sap/opu/odata/sap/ZATTENDANCEAPI_SRV/attendanceSet
# SAP_ATTENDANCE_BASE_URL="http://uolerp.uol.edu.pk:8000/sap/opu/odata/sap/ZATTENDANCEAPI_SRV/attendanceSet"

# Missing attendance reminder cron (run-missing-attendance-reminders.sh)
# Empty faculty id = all faculties with enrollment on snapshot date.
# MISSING_ATTENDANCE_FACULTY_ID=""
# Sends to every qualifying instructor (5s between each SMTP message).
# MISSING_ATTENDANCE_MIN_MISSING="4"
# MISSING_ATTENDANCE_DRY_RUN="false"
# MISSING_ATTENDANCE_OVERRIDE_TO=""  # redirect all mail in testing
# MISSING_ATTENDANCE_REPLY_TO="dean-fss@uol.edu.pk"

# Inactive login reminder cron (run-inactive-login-reminders.sh)
# Registered staff with no login for N days (default 7).
# INACTIVE_LOGIN_FACULTY_ID=""          # optional; empty = all faculties
# INACTIVE_LOGIN_INACTIVE_DAYS="7"
# INACTIVE_LOGIN_DRY_RUN="false"
# INACTIVE_LOGIN_OVERRIDE_TO=""         # redirect all mail in testing
# INACTIVE_LOGIN_REPLY_TO=""
# INACTIVE_LOGIN_PORTAL_URL="https://student-alert.uol.edu.pk/auth/sign-in"

# Optional tuning
# CURL_CONNECT_TIMEOUT=10
# CURL_MAX_TIME=1800
# RETRY_COUNT=3
# RETRY_DELAY_SECONDS=10
# LOG_DIR="/var/log/student-alert-system"
